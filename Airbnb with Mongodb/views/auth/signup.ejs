<%- include('../partials/head') %>
<body class="bg-gradient-to-br from-slate-100 via-white to-rose-50 min-h-screen">
<%- include('../partials/nav') %>
<section class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
  <div class="space-y-6 rounded-3xl border border-red-100 bg-red-50/70 p-8 shadow-lg shadow-red-100/50 backdrop-blur-sm">
    <div class="inline-flex rounded-full bg-red-100 px-4 py-2 text-sm font-semibold text-red-700">Welcome to Airbnb</div>
    <div class="space-y-4">
      <h1 class="text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl">Create your account and start hosting or booking in minutes.</h1>
      <p class="max-w-xl text-base text-slate-600">Join our community to discover beautiful homes, manage reservations from one dashboard, and get access to exclusive hosting tools.</p>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="rounded-3xl bg-white p-5 shadow-sm shadow-slate-200">
        <p class="text-sm font-semibold text-slate-900">Verified stays</p>
        <p class="mt-2 text-sm text-slate-600">Browse verified homes with detailed reviews and instant booking.</p>
      </div>
      <div class="rounded-3xl bg-white p-5 shadow-sm shadow-slate-200">
        <p class="text-sm font-semibold text-slate-900">Easy hosting</p>
        <p class="mt-2 text-sm text-slate-600">List your home quickly and manage everything from one place.</p>
      </div>
    </div>
  </div>

  <div class="mx-auto w-full max-w-md rounded-[2rem] border border-gray-200 bg-white/95 p-8 shadow-2xl shadow-slate-200/70 backdrop-blur-sm">
    <div class="text-center mb-8">
      <p class="text-xs uppercase tracking-[0.32em] text-red-600 font-semibold">Get started</p>
      <h2 class="mt-3 text-3xl font-semibold text-slate-900">Create an account</h2>
      <p class="mt-3 text-sm text-slate-500">Sign up to browse stays, host guests, and manage your trips.</p>
    </div>
    <form action="/signup" method="post" class="space-y-5">
      <%- include('../partials/err') %>
      <div>
        <label for="name" class="block text-sm font-medium text-slate-700">Full name</label>
        <input id="name" name="name" type="text" placeholder="Name" value="<%=typeof oldInput!=='undefined'?oldInput.name:''%>" required class="mt-1 block w-full rounded-3xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm transition focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-100" />
      </div>
      <div>
        <label for="email" class="block text-sm font-medium text-slate-700">Email address</label>
        <input id="email" name="email" type="email" value="<%=typeof oldInput!=='undefined'?oldInput.email:''%>" placeholder="you@example.com" required class="mt-1 block w-full rounded-3xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm transition focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-100" />
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="password" class="block text-sm font-medium text-slate-700">Password</label>
          <input id="password" name="password" type="password" placeholder="Enter password" required class="mt-1 block w-full rounded-3xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm transition focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-100" />
        </div>
        <div>
          <label for="confirmPassword" class="block text-sm font-medium text-slate-700">Confirm password</label>
          <input id="confirmPassword" name="confirmPassword" type="password" placeholder="Confirm password" required class="mt-1 block w-full rounded-3xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm transition focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-100" />
        </div>
      </div>
      <div>
        <span class="block text-sm font-medium text-slate-700">User type</span>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <label class="flex items-center rounded-3xl border border-slate-200 bg-slate-50 px-4 py-3 cursor-pointer transition hover:border-red-400">
            <input type="radio" name="userType" value="guest" class="h-4 w-4 text-red-600" checked=" <% oldInput.userType === 'guest'%>" required>
            <span class="ml-3 text-sm text-slate-700">Guest</span>
          </label>
          <label class="flex items-center rounded-3xl border border-slate-200 bg-slate-50 px-4 py-3 cursor-pointer transition hover:border-red-400">
            <input type="radio" name="userType" value="host" class="h-4 w-4 text-red-600" checked=" <% oldInput.userType === 'host' %>">
            <span class="ml-3 text-sm text-slate-700">Host</span>
          </label>
        </div>
      </div>
      <div>
        <label class="flex items-start space-x-3 text-sm text-slate-700">
          <input type="checkbox" name="termsAndConditions" class="mt-1 h-4 w-4 rounded border-slate-300 text-red-600 focus:ring-red-500" required>
          <span>I agree to the terms and conditions</span>
        </label>
      </div>
      <button type="submit" class="w-full rounded-3xl bg-red-600 py-3 text-sm font-semibold text-white shadow-lg shadow-red-500/20 transition hover:bg-red-700">Sign up</button>
      <p class="mt-4 text-center text-sm text-slate-500">Already have an account? <a href="/login" class="font-semibold text-red-600 hover:text-red-700">Login</a></p>
    </form>
  </div>
</section>
</body>