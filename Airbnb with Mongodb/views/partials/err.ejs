<% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
        <div class="rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
          <ul class="space-y-1">
            <% errors.forEach((err) => { %>
              <li><%= err %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>