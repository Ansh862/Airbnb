<%- include('../partials/head') %>
<body class="bg-gray-100 min-h-screen">
<%- include('../partials/nav') %>
<header class="bg-white border-b border-gray-200 py-10">
    <div class="max-w-5xl mx-auto px-4 text-center">
      <h1 class="text-4xl font-semibold text-gray-900"><%=editing ?"Edit" : "Register"%> your home</h1>
      <p class="mt-3 text-gray-600 max-w-2xl mx-auto"><%=editing ?'' : 'Create a listing to welcome guests from around the world and earn extra income.'%></p>
    </div>

  </header>
  <main class="min-h-screen bg-gray-100 flex items-start justify-center py-12">
    <form action="/host/<%= editing ? 'edit-home' : 'add-home' %>" method="POST" class="w-full max-w-3xl bg-white shadow-xl rounded-3xl p-10 space-y-6">
      <input name="id" type="hidden" value="<%= editing ? home.id : '' %>"/>
      <div class="grid gap-6">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">House name</label>
          <input value="<%= editing ? home.houseName : ''%>" type="text" name="houseName" placeholder="Enter your house name" class="w-full rounded-2xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 shadow-sm focus:border-black focus:outline-none focus:ring-0" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Price per night</label>
          <input value="<%= editing ? home.price : ''%>" type="text" name="price" placeholder="Enter price per night" class="w-full rounded-2xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 shadow-sm focus:border-black focus:outline-none focus:ring-0" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Location</label>
          <input value="<%= editing ? home.location : ''%>" type="text" name="location" placeholder="Enter your home location" class="w-full rounded-2xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 shadow-sm focus:border-black focus:outline-none focus:ring-0" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Rating</label>
          <input value="<%= editing ? home.rating : ''%>" type="text" name="rating" placeholder="Enter rating" class="w-full rounded-2xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 shadow-sm focus:border-black focus:outline-none focus:ring-0" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Photo URL</label>
          <input value="<%= editing ? home.photourl : ''%>" type="text" name="photourl" placeholder="Enter photo URL" class="w-full rounded-2xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 shadow-sm focus:border-black focus:outline-none focus:ring-0" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Description</label>
          <textarea name="description" placeholder="Describe about home" class="w-full rounded-2xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 shadow-sm focus:border-black focus:outline-none focus:ring-0"><%= editing ? home.description : '' %></textarea>
        </div>
        <div class="pt-2">
          <input type="submit" value="<%= editing ? 'Update Home' : 'Publish listing'%>" class="w-full rounded-2xl bg-black px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-gray-900 cursor-pointer" />
        </div>
      </div>
    </form>
  </main>
</body>
</html>