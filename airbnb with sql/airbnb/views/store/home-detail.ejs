<%- include('../partials/head') %>
<body>
  <%- include('../partials/nav') %>    
  <div class="container mx-auto p-8">
    <% if (home) { %>
      <div class="bg-white rounded-lg shadow-lg p-6">
        <h1 class="text-3xl font-bold text-red-500 mb-4">
          <%= home.houseName %>
        </h1>
        
        <div class="mb-6">
          <img src="<%= home.photourl %>" alt="<%= home.title %>" class="w-full h-96 object-cover rounded-lg">
        </div>
        
        <div class="grid grid-cols-2 gap-4 mb-6">
          <div>
            <p class="text-gray-600 font-semibold">Price per night:</p>
            <p class="text-2xl font-bold text-green-600">₹<%= home.price %></p>
          </div>
          <div>
            <p class="text-gray-600 font-semibold">Location:</p>
            <p class="text-lg"><%= home.location %></p>
          </div>
          <div>
            <p class="text-gray-600 font-semibold">Bedrooms:</p>
            <p class="text-lg"><%= home.bedrooms %></p>
          </div>
          <div>
            <p class="text-gray-600 font-semibold">Bathrooms:</p>
            <p class="text-lg"><%= home.bathrooms %></p>
          </div>
          <div>
            <p class="text-gray-600 font-semibold">Rating:</p>
            <p class="text-lg font-bold text-yellow-500"><%= home.rating || 'N/A' %>/5 ⭐</p>
          </div>
        </div>
        
        <div class="mb-6">
          <p class="text-gray-600 font-semibold mb-2">Description:</p>
          <p class="text-gray-700"><%= home.description %></p>
        </div>
        
        <div class="mb-6">
          <p class="text-gray-600 font-semibold mb-2">Amenities:</p>
          <ul class="list-disc list-inside text-gray-700">
            <% if (Array.isArray(home.amenities)) { %>
              <% home.amenities.forEach(amenity => { %>
                <li><%= amenity %></li>
              <% }); %>
            <% } %>
          </ul>
        </div>
        <div class="flex justify-between items-center mb-2">

          <button class="bg-red-500 hover:bg-red-600 text-white font-bold py-2 px-6 rounded-lg">
            Book Now
          </button>
           <%- include('../partials/fav') %>
        </div>
      </div>
    <% } %>
  </div>
</body>
</html>